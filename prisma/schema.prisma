generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  admin
  client
}

enum ClientStatus {
  Onboarding
  Active
  Paused
  Churned
}

enum CampaignStatus {
  Active
  Paused
  InReview
  Ended
}

enum CreativeType {
  image
  video
  carousel
}

enum CreativeStatus {
  Active
  Paused
  Archived
}

enum BriefStatus {
  draft
  awaiting_approval
  approved
  changes_requested
}

enum ReportType {
  weekly
  monthly
  qbr
}

enum InvoiceStatus {
  draft
  sent
  paid
  overdue
}

enum LeadStatus {
  New
  Contacted
  CallBooked
  Qualified
  Converted
  Lost
}

enum AlertType {
  roas_drop
  high_frequency
  budget_overpace
  budget_underpace
}

enum AlertStatus {
  open
  reviewed
  closed
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String?
  role          UserRole  @default(client)
  passwordHash  String?
  image         String?
  preferences   Json?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts      Account[]
  sessions      Session[]
  client        Client?
  sentMessages  Message[] @relation("SentMessages")
  passwordResets PasswordReset[]
  loginAttempts LoginAttempt[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model PasswordReset {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  used      Boolean  @default(false)
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model LoginAttempt {
  id        String   @id @default(cuid())
  email     String
  userId    String?
  success   Boolean
  createdAt DateTime @default(now())
  ip        String?

  user User? @relation(fields: [userId], references: [id])

  @@index([email, createdAt])
}

model Client {
  id              String       @id @default(cuid())
  userId          String       @unique
  companyName     String
  websiteUrl      String?
  adAccountId     String?
  retainerTier    String?
  roasTarget      Float?
  status          ClientStatus @default(Onboarding)
  onboardingData  Json?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  campaigns  Campaign[]
  reports    Report[]
  briefs     Brief[]
  invoices   Invoice[]
  messages   Message[]
  alerts     Alert[]
  leads      Lead[]
}

model Campaign {
  id          String         @id @default(cuid())
  clientId    String
  name        String
  objective   String?
  status      CampaignStatus @default(Active)
  dailyBudget Float?
  startDate   DateTime?
  endDate     DateTime?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  client    Client     @relation(fields: [clientId], references: [id], onDelete: Cascade)
  metrics   Metric[]
  creatives Creative[]
  alerts    Alert[]
}

model Metric {
  id          String   @id @default(cuid())
  campaignId  String
  date        DateTime @db.Date
  spend       Float    @default(0)
  impressions Int      @default(0)
  clicks      Int      @default(0)
  purchases   Int      @default(0)
  revenue     Float    @default(0)
  roas        Float?
  cpm         Float?
  ctr         Float?
  cpp         Float?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@unique([campaignId, date])
}

model Creative {
  id         String         @id @default(cuid())
  campaignId String
  name       String
  type       CreativeType
  url        String?
  status     CreativeStatus @default(Active)
  frequency  Float          @default(0)
  ctr        Float?
  roas       Float?
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt

  campaign Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
}

model Brief {
  id        String      @id @default(cuid())
  clientId  String
  title     String
  status    BriefStatus @default(draft)
  content   Json?
  history   Json?
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)
}

model Report {
  id          String     @id @default(cuid())
  clientId    String
  name        String
  type        ReportType
  periodStart DateTime
  periodEnd   DateTime
  generatedAt DateTime   @default(now())
  url         String?
  createdAt   DateTime   @default(now())

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)
}

model Invoice {
  id          String        @id @default(cuid())
  clientId    String
  amount      Float
  status      InvoiceStatus @default(draft)
  description String?
  dueDate     DateTime
  paidAt      DateTime?
  history     Json?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)
}

model Lead {
  id           String     @id @default(cuid())
  name         String?
  email        String?
  storeUrl     String?
  platform     String?
  monthlySpend String?
  goal         String?
  priorAgency  Boolean?
  source       String?
  status       LeadStatus @default(New)
  notes        String?
  clientId     String?
  submittedAt  DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  client Client? @relation(fields: [clientId], references: [id])
}

model Message {
  id        String   @id @default(cuid())
  clientId  String
  senderId  String
  body      String
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)
  sender User   @relation("SentMessages", fields: [senderId], references: [id])
}

model Alert {
  id           String      @id @default(cuid())
  clientId     String
  campaignId   String?
  type         AlertType
  threshold    Float?
  currentValue Float?
  priorValue   Float?
  dismissNote  String?
  status       AlertStatus @default(open)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  client   Client    @relation(fields: [clientId], references: [id], onDelete: Cascade)
  campaign Campaign? @relation(fields: [campaignId], references: [id])
}

model Settings {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String
  updatedAt DateTime @updatedAt
}
